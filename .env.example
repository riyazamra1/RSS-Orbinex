# Local development only. Do not reuse these database credentials in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://rss_orbinex:local-dev-only-change-before-sharing@127.0.0.1:5432/rss_orbinex
DATABASE_SSL=false
# Replace with a random secret of at least 32 characters before bootstrap.
BOOTSTRAP_SECRET=replace-with-random-secret-at-least-32-characters

# Exact browser origins allowed to call the API, comma-separated.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rssapps.net,https://www.rssapps.net
